# Environment and credentials (NEVER commit secrets)
.env
.env.local
.env.*.local
*.env
*.key
*.pem
*.cert

# Python virtual environments & bytecode
.venv/
venv/
env/
ENV/
backend/.venv/
__pycache__/
*.py[cod]
*$py.class

# Testing, coverage, and cache
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js dependencies & builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases and runtime data caches
*.sqlite
*.sqlite3
*.db
backend/data/system.db
backend/data/cache/*
!backend/data/cache/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/labels/*
!backend/data/labels/.gitkeep

# Operating System & Editor artifacts
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
NTUSER.DAT*
ntuser.dat*
.vscode/
.idea/
*.swp
*.swo
*~
